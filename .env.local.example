# ============================================================
# Socially AI — Environment Variables
# Copy this file to .env.local and fill in your values.
# Everything is optional for local dev: the app mocks AI, and each
# integration only activates once its keys are present.
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
# https://app.supabase.com → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Service-role key (server only) — used by the sync worker / webhooks.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── AI model (vLLM / OpenAI-compatible) ──────────────────────
# Self-hosted Llama 3.3 70B, or a hosted OpenAI-compatible endpoint
# (Together / Groq / Fireworks / DeepInfra). Leave empty to use mocks.
VLLM_SERVER_URL=http://your-gpu-server:8000
LLAMA_MODEL=meta-llama/Llama-3.3-70B-Instruct
# If your endpoint needs a bearer key (hosted providers):
# LLM_API_KEY=your_provider_api_key

# ── Trends web search (optional) ─────────────────────────────
# Powers the Trends page live web search. Any one works.
TAVILY_API_KEY=your_tavily_key
# SERPAPI_KEY=your_serpapi_key

# ── Payments (Paystack) ───────────────────────────────────────
# https://dashboard.paystack.com → Settings → API Keys
# Webhook URL (Settings → API Keys & Webhooks): {APP_URL}/api/billing/webhook
# Plan codes are optional — set them to bill as recurring subscriptions;
# without them, checkout charges a one-off for the plan amount.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxx
NEXT_PUBLIC_PAYSTACK_BASIC_PLAN=PLN_xxxxxx
NEXT_PUBLIC_PAYSTACK_PRO_PLAN=PLN_xxxxxx
NEXT_PUBLIC_PAYSTACK_ADVANCED_PLAN=PLN_xxxxxx

# ============================================================
# SOCIAL PLATFORM OAUTH APPS
# Redirect/callback URL for each: {APP_URL}/api/social/callback/<platform>
# ============================================================

# X (Twitter) — https://developer.twitter.com  (OAuth 2.0 + PKCE)
X_CLIENT_ID=your_x_client_id
X_CLIENT_SECRET=your_x_client_secret

# LinkedIn — https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

# Meta — Instagram + Facebook + Threads — https://developers.facebook.com
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret

# Google — YouTube (also used by Google Calendar / Analytics / Sheets)
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Snapchat — https://developers.snap.com
SNAPCHAT_CLIENT_ID=your_snapchat_client_id
SNAPCHAT_CLIENT_SECRET=your_snapchat_client_secret

# Reddit — https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret

# TikTok — https://developers.tiktok.com
TIKTOK_CLIENT_ID=your_tiktok_client_id
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret

# ── Messaging platforms (token-based, not OAuth) ─────────────
# Telegram — create a bot with @BotFather, paste its token in the app UI.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# WhatsApp Cloud API — https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_TOKEN=your_whatsapp_cloud_api_token
WHATSAPP_PHONE_ID=your_whatsapp_phone_number_id

# ============================================================
# TOOLS & ANALYTICS (Integrations → Tools)
# Callback URL for each: {APP_URL}/api/tools/callback/<provider>
# Google Calendar / Analytics / Sheets reuse GOOGLE_CLIENT_ID above.
# ============================================================

# Slack — https://api.slack.com/apps
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret

# Notion — https://www.notion.so/my-integrations
NOTION_CLIENT_ID=your_notion_client_id
NOTION_CLIENT_SECRET=your_notion_client_secret

# Discord — https://discord.com/developers/applications
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret

# Mailchimp — API key connector — https://mailchimp.com/help/about-api-keys
MAILCHIMP_API_KEY=your_mailchimp_api_key

# ── Queue (BullMQ + Redis) ────────────────────────────────────
# Background jobs (scheduled posts/messages, sync). Upstash works great.
REDIS_URL=redis://localhost:6379

# ── ROI Tracking ──────────────────────────────────────────────
# Shared secret to verify conversion webhooks. Generate: openssl rand -hex 32
ROI_WEBHOOK_SECRET=your_webhook_secret

# ── Support & transactional email (nodemailer / SMTP) ────────
# Where in-app support messages are delivered.
SUPPORT_EMAIL=...
# SMTP credentials used to actually send the emails. Without them,
# support tickets are still stored in the support_tickets table.
# Gmail: create an App Password (Google Account → Security → App passwords).
SMTP_HOST=...
SMTP_PORT=...
SMTP_SECURE=...
SMTP_USER=...
SMTP_PASS=your_gmail_app_password
SMTP_FROM=...